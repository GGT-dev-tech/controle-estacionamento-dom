# ── Banco de dados ──────────────────────────────────────────────
# Dev local (MySQL via Docker): mysql+aiomysql://dom_user:dom_pass@mysql:3306/estacionamento
# Produção (Railway PostgreSQL): postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=mysql+aiomysql://dom_user:dom_pass@mysql:3306/estacionamento

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://:redispassword@redis:6379

# ── Ambiente ────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000
API_HOST=localhost

# ── Auth0 ───────────────────────────────────────────────────────
AUTH0_DOMAIN=seu-tenant.auth0.com
AUTH0_AUDIENCE=https://api.estacionamento.dom
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# ── Evolution API (WhatsApp) ────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=CHAVE_ALEATORIA_FORTE_MIN_32_CHARS
EVOLUTION_INSTANCE_NAME=dom-estacionamento

# ── Resend (Email) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@dompagamentos.com.br

# ── Frontend (Vite — expostas ao browser) ──────────────────────
VITE_API_URL=http://localhost:8000
VITE_AUTH0_DOMAIN=seu-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.estacionamento.dom
