# ── Banco de dados ──────────────────────────────────────────────
# Dev local (MySQL via Docker): mysql+aiomysql://dom_user:dom_pass@mysql:3306/estacionamento
# Produção (Railway PostgreSQL): postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=mysql+aiomysql://dom_user:dom_pass@mysql:3306/estacionamento

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://:redispassword@redis:6379

# ── Ambiente ────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000
API_HOST=localhost

# ── Auth0 ───────────────────────────────────────────────────────
AUTH0_DOMAIN=seu-tenant.auth0.com
AUTH0_AUDIENCE=https://api.estacionamento.dom
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# ── Evolution API (WhatsApp) ────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=CHAVE_ALEATORIA_FORTE_MIN_32_CHARS
EVOLUTION_INSTANCE_NAME=dom-estacionamento
# Segredo embutido na URL do webhook — configure a Evolution API para chamar
# POST {API_URL}/webhook/whatsapp/{WHATSAPP_WEBHOOK_SECRET} (mínimo 32 chars aleatórios).
WHATSAPP_WEBHOOK_SECRET=CHAVE_ALEATORIA_FORTE_MIN_32_CHARS

# ── Resend (Email) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@dompagamentos.com.br
# E-mails (separados por vírgula) que recebem o relatório diário
RELATORIO_DESTINATARIOS=admin@dompagamentos.com.br

# ── Tarefas agendadas (Railway Cron ou similar) ─────────────────
# Header X-Cron-Secret exigido por /reservas/expirar-vencidas e /relatorios/diario/enviar
CRON_SECRET=CHAVE_ALEATORIA_FORTE_MIN_32_CHARS

# ── Auth0 Post-Login Action ──────────────────────────────────────
# Header X-Internal-Secret exigido por /admin/dominios/{d}/verificar e /admin/admins/{e}/verificar
# (configure o mesmo valor como Auth0 Secret "INTERNAL_API_SECRET" na Action)
AUTH0_ACTION_SECRET=CHAVE_ALEATORIA_FORTE_MIN_32_CHARS

# ── Frontend (Vite — expostas ao browser) ──────────────────────
VITE_API_URL=http://localhost:8000
VITE_AUTH0_DOMAIN=seu-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.estacionamento.dom
